{
    "name": "mattfalahe/industry-manager",
    "description": "Industry calculator + best-structure picker (rig-bonus aware) for SeAT. Pure read-only consumer — no ESI calls.",
    "type": "seat-plugin",
    "keywords": ["seat", "eve", "eveonline", "industry", "manufacturing", "blueprint", "rig", "plugin"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Matt Falahe",
            "email": "mattfalahe@gmail.com"
        }
    ],
    "homepage": "https://github.com/MattFalahe/Industry-Manager",
    "require": {
        "php": "^8.0",
        "laravel/framework": "^10.0",
        "eveseat/web": "^5.0",
        "eveseat/services": "^5.0",
        "eveseat/eveapi": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "IndustryManager\\": "src/",
            "IndustryManager\\Database\\Seeders\\": "src/Database/seeders"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndustryManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IndustryManager\\IndustryManagerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
